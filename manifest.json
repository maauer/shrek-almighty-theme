{
    "manifest_version": 2,
    "version": "1.1",
    "name": "shrek-almighty-theme",
    "browser_specific_settings": {
        "gecko": {
            "id": "@addon-shronky",
            "data_collection_permissions": {
            "required": [
                "none"
            ]
            },
            "strict_min_version": "140.0"
        }
    },
    "theme": {
        "images": {
            "additional_backgrounds": ["images/daddy-shrek.png"]
        },
        "properties": {
            "additional_backgrounds_alignment": ["right top"],
            "additional_backgrounds_tiling": ["repeat"]
        },
        "colors": {
        "toolbar": "rgb(233, 237, 240)",
        "toolbar_text": "rgb(214, 81, 109)",
        "frame": "rgb(73, 153, 201)",
        "tab_background_text": "rgb(248, 248, 248)",
        "toolbar_field": "rgb(252, 252, 252)",
        "toolbar_field_text": "rgb(214, 81, 109)",
        "tab_line": "rgb(214, 81, 109)",
        "popup": "rgb(233, 237, 240)",
        "popup_text": "rgb(177, 63, 87)",
        "tab_loading": "rgb(214, 81, 109)"
        }
    }
}
